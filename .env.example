# Copy this file to .env (or .env.local) and fill in real values from
# your Supabase project dashboard (Settings → API). Everything here is
# client-exposed (Vite only inlines VITE_-prefixed vars into the bundle),
# so only ever put publishable/anon-level values in this file -- never a
# service_role key or any other server-side secret. The anon/publishable
# key below is intentionally a real, working value: it's already shipped
# in every production client bundle (visible to anyone via dev tools on
# the live site), so committing it to a template file carries no
# additional exposure.

# Required -- the app crashes at boot ("supabaseUrl is required") without
# these. Project ref for this repo is kwmcocsitwssrtzkdojh.
VITE_SUPABASE_URL="https://kwmcocsitwssrtzkdojh.supabase.co"
VITE_SUPABASE_PUBLISHABLE_KEY="eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJpc3MiOiJzdXBhYmFzZSIsInJlZiI6Imt3bWNvY3NpdHdzc3J0emtkb2poIiwicm9sZSI6ImFub24iLCJpYXQiOjE3NTkxNzA3MzYsImV4cCI6MjA3NDc0NjczNn0.ZiAk_MZuQkA0quxb7KABtlJ1cY1KUAyXw55OebmUT4c"
VITE_SUPABASE_PROJECT_ID="kwmcocsitwssrtzkdojh"

# Non-VITE-prefixed duplicates of the two above -- read server-side (not
# through Vite's client bundling) by this repo's own MCP tool
# implementation (src/lib/mcp/tools/*.ts, via process.env). Same values,
# same safety note.
SUPABASE_URL="https://kwmcocsitwssrtzkdojh.supabase.co"
SUPABASE_PUBLISHABLE_KEY="eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJpc3MiOiJzdXBhYmFzZSIsInJlZiI6Imt3bWNvY3NpdHdzc3J0emtkb2poIiwicm9sZSI6ImFub24iLCJpYXQiOjE3NTkxNzA3MzYsImV4cCI6MjA3NDc0NjczNn0.ZiAk_MZuQkA0quxb7KABtlJ1cY1KUAyXw55OebmUT4c"

# Optional -- safe to leave blank for local dev; each degrades gracefully
# when unset (no error reporting, no push notifications, canonical-URL
# fallback respectively).
VITE_SENTRY_DSN=
VITE_VAPID_PUBLIC_KEY="BHUeq8A8KUTkifx675Ll_C2R5dJHrSQggyim07tgr6lD1LK-yI31mtUJfJiJjOrYHv4Zn4ewFTGPQ8aUVcMMVZA"
VITE_SITE_URL=http://localhost:8080

# Optional build-time flag, only read by vite.config.ts -- leave unset
# unless you're specifically testing static social-share page generation.
VITE_GENERATE_STATIC_SOCIAL_PAGES=false
