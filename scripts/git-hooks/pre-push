#!/bin/sh
# Kretopia pre-push guard. Installed by scripts/install-git-hooks.sh; the rules are explained in scripts/git-hooks/README.md.
#
# Nothing is pushed to main or master, whatever the local branch is called: `git push origin HEAD:main`, `git push origin feature:main`,
# `git push origin main` and `git push origin :main` (a deletion) all end here. A branch is published with `git push -u origin <name>` and
# reaches main through a pull request.
#
# git passes "<local ref> <local oid> <remote ref> <remote oid>" for every ref on standard input (githooks(5)); $1 is the remote's name.
# `git push --no-verify` skips this: it is a safety net, not a lock. The lock is the branch protection on GitHub.

status=0
while read -r local_ref _ remote_ref _; do
  case "$remote_ref" in
    refs/heads/main | refs/heads/master)
      printf '%s\n' \
        "pre-push: refusing to push '${local_ref}' to '${remote_ref}' on '${1:-the remote}'." \
        "  main changes only through a reviewed pull request. Publish the branch instead:" \
        "    git push -u origin <name>" \
        "    gh pr create --repo Kretopia/kretopia-connect" >&2
      status=1
      ;;
  esac
done

exit $status
